{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-portal.dev/schemas/eventcatalog/1.0.json",
  "title": "Event catalogue (events.yaml)",
  "type": "object",
  "required": [
    "eventcatalog",
    "title",
    "version",
    "messages"
  ],
  "additionalProperties": false,
  "properties": {
    "eventcatalog": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "description": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "datacontenttype": {
          "type": "string"
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "message": {
      "type": "object",
      "required": [
        "type",
        "role",
        "summary",
        "dataschema"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+\\.v[0-9]+$"
        },
        "role": {
          "enum": [
            "produces",
            "receives"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "datacontenttype": {
          "type": "string"
        },
        "dataschema": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "$ref"
              ],
              "additionalProperties": false,
              "properties": {
                "$ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "required": [
                "schema"
              ],
              "additionalProperties": false,
              "properties": {
                "schema": {
                  "type": "object"
                }
              }
            }
          ]
        },
        "dataschemauri": {
          "type": "string",
          "format": "uri"
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]{1,20}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "boolean",
                  "binary",
                  "uri",
                  "uri-reference",
                  "timestamp"
                ]
              }
            }
          }
        },
        "bindings": {
          "$ref": "#/$defs/bindings"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "data"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "data": {}
            }
          }
        },
        "deprecated": {
          "type": "boolean"
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": false,
        "properties": {
          "kafka": {
            "type": "object",
            "required": [
              "topic"
            ],
            "additionalProperties": false,
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "from",
                      "pointer"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "from": {
                        "const": "data"
                      },
                      "pointer": {
                        "type": "string",
                        "pattern": "^(/[^/]+)+$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "from",
                      "name"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "from": {
                        "const": "extension"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "from"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "from": {
                        "const": "subject"
                      }
                    }
                  }
                ]
              },
              "mode": {
                "enum": [
                  "binary",
                  "structured"
                ],
                "default": "binary"
              }
            }
          },
          "nats": {
            "type": "object",
            "required": [
              "subject"
            ],
            "additionalProperties": false,
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "stream": {
                "type": "string"
              }
            }
          },
          "sns": {
            "type": "object",
            "required": [
              "topic"
            ],
            "additionalProperties": false,
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "sqs": {
            "type": "object",
            "required": [
              "queue"
            ],
            "additionalProperties": false,
            "properties": {
              "queue": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "pubsub": {
            "type": "object",
            "required": [
              "topic"
            ],
            "additionalProperties": false,
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "eventbridge": {
            "type": "object",
            "required": [
              "bus"
            ],
            "additionalProperties": false,
            "properties": {
              "bus": {
                "type": "string",
                "minLength": 1
              },
              "detailType": {
                "type": "string"
              }
            }
          },
          "servicebus": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "queue": {
                "type": "string",
                "minLength": 1
              }
            },
            "oneOf": [
              {
                "required": [
                  "topic"
                ]
              },
              {
                "required": [
                  "queue"
                ]
              }
            ]
          }
        }
      }
    }
  }
}
