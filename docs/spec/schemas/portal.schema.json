{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-portal.dev/schemas/portal/v1.json",
  "title": "API portal descriptor (portal.yaml)",
  "type": "object",
  "required": ["apiVersion", "owner", "apis"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "portal/v1" },
    "owner": { "$ref": "#/$defs/slug" },
    "system": { "$ref": "#/$defs/slug" },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "apis": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/api" }
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["api"],
        "additionalProperties": false,
        "properties": {
          "api": { "$ref": "#/$defs/apiId" },
          "types": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/eventType" }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "apiId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+\\.v[0-9]+$"
    },
    "link": {
      "type": "object",
      "required": ["title", "url"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "api": {
      "type": "object",
      "required": ["id", "kind", "spec", "lifecycle"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/apiId" },
        "kind": { "enum": ["openapi", "asyncapi", "cloudevents"] },
        "spec": { "type": "string", "minLength": 1 },
        "title": {
          "type": "string",
          "description": "Overrides the title taken from the spec."
        },
        "owner": { "$ref": "#/$defs/slug" },
        "lifecycle": {
          "enum": ["experimental", "production", "deprecated", "retired"]
        },
        "sunset": { "type": "string", "format": "date" },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "compatibility": { "enum": ["BACKWARD", "FORWARD", "FULL", "NONE"] },
        "ruleset": {
          "type": "string",
          "description": "Name of a portal-configured ruleset overriding the default for this kind."
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "$ref": "#/$defs/slug" },
              "url": { "type": "string", "format": "uri" },
              "broker": { "$ref": "#/$defs/slug" }
            },
            "oneOf": [{ "required": ["url"] }, { "required": ["broker"] }]
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "openapi" } } },
          "then": { "not": { "required": ["compatibility"] } }
        },
        {
          "if": {
            "properties": { "lifecycle": { "not": { "const": "deprecated" } } }
          },
          "then": { "not": { "required": ["sunset"] } }
        }
      ]
    }
  }
}
