{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Money",
  "type": "object",
  "required": ["amount", "currency"],
  "properties": {
    "amount": { "type": "integer", "description": "Minor units, e.g. cents." },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
  }
}
