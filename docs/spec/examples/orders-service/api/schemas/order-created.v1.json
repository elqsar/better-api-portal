{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderCreated",
  "type": "object",
  "required": ["orderId", "customerId", "total"],
  "properties": {
    "orderId": { "type": "string" },
    "customerId": { "type": "string" },
    "total": { "$ref": "./money.json" },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sku", "quantity"],
        "properties": {
          "sku": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
